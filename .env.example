# Braid runs with zero configuration on keyless public endpoints.
# Every variable below is optional and only raises throughput or coverage.

# --- Server ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser. Default: same-origin only.
BRAID_CORS_ORIGINS=
# Comma-separated API keys. When set, every /v1 route requires `Authorization: Bearer <key>`.
BRAID_API_KEYS=
# Requests per minute per IP or API key (0 disables the limiter). Health checks and the read-only
# metadata routes are exempt.
BRAID_RATE_LIMIT=60
# Analyses per minute. Starting an analysis is the only route that spends upstream requests.
BRAID_ANALYZE_RATE_LIMIT=10

# --- EVM data providers ---
# Etherscan V2 multichain key. When present it is preferred over Blockscout: faster,
# higher rate limits and coverage for every chain in the registry.
ETHERSCAN_API_KEY=
# Override the Blockscout instance for a chain: BRAID_BLOCKSCOUT_<CHAIN_SLUG_UPPER>=https://host
BRAID_BLOCKSCOUT_ETHEREUM=

# --- Solana data providers ---
# Any Solana JSON-RPC URLs, highest priority first. Defaults to public keyless endpoints.
SOLANA_RPC_URLS=
# Convenience: a Helius key builds https://mainnet.helius-rpc.com/?api-key=<key> as the first RPC.
HELIUS_API_KEY=

# --- Cache ---
# Redis connection string for a shared provider cache. Falls back to in-process LRU.
REDIS_URL=
BRAID_CACHE_TTL_SECONDS=900
